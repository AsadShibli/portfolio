# Contact form (app/actions/contact.ts). Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Where contact messages are delivered.
CONTACT_TO_EMAIL=
# Optional. Without a verified domain, Resend only sends from onboarding@resend.dev
# and only to the email on your Resend account.
CONTACT_FROM_EMAIL=

# Optional. Raises the GitHub API limit for the project carousel (no scopes needed).
GITHUB_TOKEN=
